<!-- Hero Section -->
<section class="hero">
    <div class="container">
        <div class="hero-content">
            <div class="hero-text">
                <span class="badge">🚗 Premium Car Rental</span>
                <h1>Rent the Perfect Car for Your Journey</h1>
                <p>Choose from our wide selection of quality vehicles at competitive prices. Drive with confidence and comfort.</p>
                <div class="hero-buttons">
                    <a href="/cars" class="btn btn-primary">
                        <i class="fas fa-car"></i> Browse Cars
                    </a>
                    <a href="/booking" class="btn btn-secondary">
                        <i class="fas fa-calendar-check"></i> Book Now
                    </a>
                </div>
                <div class="hero-stats">
                    <div class="stat">
                        <span class="number">500+</span>
                        <span class="label">Happy Customers</span>
                    </div>
                    <div class="stat">
                        <span class="number">100+</span>
                        <span class="label">Cars Available</span>
                    </div>
                    <div class="stat">
                        <span class="number">4.8</span>
                        <span class="label">⭐ Average Rating</span>
                    </div>
                </div>
            </div>
            <div class="hero-image">
                <img src="/images/hero-car.png" alt="Luxury Car" class="hero-car-image" onerror="this.src='https://via.placeholder.com/600x400/2563eb/ffffff?text=RentCar'">
            </div>
        </div>
    </div>
</section>

