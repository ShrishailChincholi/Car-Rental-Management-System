<!-- How It Works Section -->
<section class="how-it-works">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Simple Process</span>
            <h2>How It Works</h2>
            <p>Renting a car has never been easier. Follow these simple steps</p>
        </div>
        <div class="steps">
            <div class="step">
                <div class="step-number">01</div>
                <div class="step-icon">
                    <i class="fas fa-search"></i>
                </div>
                <h3>Choose a Car</h3>
                <p>Browse our extensive collection and pick the perfect car for your needs</p>
            </div>
            <div class="step">
                <div class="step-number">02</div>
                <div class="step-icon">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <h3>Book Online</h3>
                <p>Fill in your details, select dates, and confirm your booking instantly</p>
            </div>
            <div class="step">
                <div class="step-number">03</div>
                <div class="step-icon">
                    <i class="fas fa-key"></i>
                </div>
                <h3>Pick Up & Drive</h3>
                <p>Pick up your car at the designated location and enjoy your journey</p>
            </div>
        </div>
    </div>
</section>

